# For local Node.js startup: npm run setup generates a private .env.
ATLAS_TOKEN=replace-with-a-random-key-at-least-32-characters
HOST=127.0.0.1
PORT=3000
DATA_FILE=data/workspace.json
PUBLIC_ORIGIN=
# Optional: the exact GitHub Pages origin, with no repository path.
ALLOWED_ORIGINS=
# Docker Compose / Caddy only. Deploy script fills this automatically.
ATLAS_DOMAIN=atlas.example.com
